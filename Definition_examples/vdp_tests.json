{
    "VDP_1":{
        "saving": {
            "type": "Y",
            "first_frame": 0,
            "last_frame": 0
        },
        
        "simulation_parameters":{
            "floatType": "float",
            "TOLERANCE_AMR": "1E-5",
            "__CGrad_TOLERANCE__": "1E-9",
            "DISC_RADIUS": "6.49",

            "phase_space_dimensions": "2",
            "DOMAIN_INF": "{-10, -10}",
            "DOMAIN_SUP": "{10, 10}",

            "param_space_dimensions": "1",

            "disc_finest_level": "10",
            "t0": "0",
            "tF": "4.0",
            "delta_t": "0.002",
            "reinit_steps": "5",
            "saving_steps": "4"
        },

        "vector_field":{
            "VF_1": "X.dim[1]",
            "D_1": "0",
            
            "VF_2": "parameter.sample_vec[0]*(1 - powf(X.dim[0], 2))*X.dim[1] - 5*X.dim[0]",
            "D_2": "parameter.sample_vec[0]*(1 - powf(X.dim[0], 2))",

            "VEC_FIELD": "{VF_1, VF_2}",
            "DIVERGENCE": "D_1 + D_2"
        },


        "initial_condition":{
            "IC_NAMES": "{'N', 'N'}",
            "IC_isTRUNC": "{true, true}",
            "IC_InfTVAL": "DOMAIN_INF",
            "IC_SupTVAL": "DOMAIN_SUP",
            "IC_MEAN": "{ 1.0f, -1.0f }",
            "IC_STD": "{ sqrtf(0.3), sqrtf(0.3) }"
        },

        "parameters":{
            "DIST_NAMES": "{'U'}",
            "DIST_isTRUNC": "{true}",
            "DIST_InfTVAL": "{-10.5}",
            "DIST_SupTVAL": "{10.5}",
            "DIST_MEAN": "{1.0}",
            "DIST_STD": "{sqrtf(0.3)}",
            "DIST_N_SAMPLES": "{64}"
        }
    }
}